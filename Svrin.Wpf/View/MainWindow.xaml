<Window x:Class="Svrin.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Svrin.Wpf.View"
        xmlns:vm="clr-namespace:Svrin.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="23"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Поле:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Width="160"
              ItemsSource="{Binding SearchFields}"
              SelectedItem="{Binding SelectedSearchField}"
              DisplayMemberPath="Title"
              Margin="0,0,10,0"/>

            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="250"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>

            <Button Content="Очистить" Margin="5,0,0,0"
                    Command="{Binding ClearSearchCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  RowHeaderWidth="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  ItemsSource="{Binding Elements}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEquals}" Value="True">
                            <Setter Property="Background" Value="#FFD8F5D8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter Property="BorderBrush" Value="Red"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True"
                                    Header="Id"
                                    Binding="{Binding Id, Mode=OneWay}"
                                    Width="150"/>
                <DataGridTextColumn IsReadOnly="True" 
                                    Header="Имя"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    Width="*"/>
                <DataGridTextColumn IsReadOnly="True" 
                                    Header="Уровень"
                                    Binding="{Binding Level, Mode=OneWay}"
                                    Width="*"/>
                <DataGridTextColumn IsReadOnly="True" 
                                    Header="Текущее значение"
                                    Binding="{Binding CurrentValue, Mode=OneWay}"
                                    Width="*"/>
                <DataGridTemplateColumn Header="Новое значение" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NewValue, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="ToolTip" Value="Шаблон содержит ошибку"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="Настройки"
                    Command="{Binding OpenSettingsCommand}"
                    HorizontalAlignment="Right"/>
            
            <StackPanel  Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Применить"
                        Command="{Binding ApplyCommand}"/>
                <Button Content="Обновить"
                        Command="{Binding LoadCommand}"
                        Margin="5,0"/>
                <Button Content="Закрыть"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
