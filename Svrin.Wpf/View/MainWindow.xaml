<Window x:Class="Svrin.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Svrin.Wpf.View"
        xmlns:vm="clr-namespace:Svrin.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="23"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Документ:"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentDocument}" MinWidth="120"/>
            <Button Grid.Column="2"
                    Content="Обновить"
                    Command="{Binding LoadCommand}"
                    HorizontalAlignment="Right"/>
        </Grid>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Поле:" Margin="0,0,5,0"/>
            <ComboBox Width="160"
              ItemsSource="{Binding SearchFields}"
              SelectedItem="{Binding SelectedSearchField}"
              DisplayMemberPath="Title"
              Margin="0,0,10,0"/>

            <TextBlock Text="Поиск:" Margin="0,0,5,0"/>
            <TextBox Width="250"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>

            <CheckBox IsChecked="{Binding ShowTimeReport, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      Content="Показать время выполнения"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  RowHeaderWidth="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  ItemsSource="{Binding Elements}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEquals}" Value="True">
                            <Setter Property="Background" Value="#FFD8F5D8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter Property="BorderBrush" Value="Red"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True"
                                    Header="Id"
                                    Binding="{Binding Id, Mode=OneWay}"
                                    Width="150"/>
                <DataGridTextColumn IsReadOnly="True" 
                                    Header="Имя"
                                    Binding="{Binding Name, Mode=OneWay}"
                                    Width="*"/>
                <DataGridTextColumn IsReadOnly="True" 
                                    Header="Уровень"
                                    Binding="{Binding Level, Mode=OneWay}"
                                    Width="*"/>
                <DataGridTextColumn IsReadOnly="True" 
                                    Header="Текущее значение"
                                    Binding="{Binding CurrentValue, Mode=OneWay}"
                                    Width="*"/>
                <DataGridTextColumn Header="Новое значение"
                                    Binding="{Binding NewValue,
                                      UpdateSourceTrigger=PropertyChanged,
                                      ValidatesOnNotifyDataErrors=True}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip"
                                    Value="{Binding RelativeSource={RelativeSource Self},
                                Path=(Validation.Errors)[0].ErrorContent}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="ToolTip"
                                    Value="{Binding RelativeSource={RelativeSource Self},
                                Path=(Validation.Errors)[0].ErrorContent}" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>

                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="Настройки"
                    Command="{Binding OpenSettingsCommand}"
                    HorizontalAlignment="Right"/>
            
            <StackPanel  Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Применить"
                        Command="{Binding ApplyCommand}" Margin="0,0,5,0"/>
                
                <Button Content="Закрыть"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
