<!--RevitProject.props-->
<Project>

	<Import Project="$(MSBuildThisFileDirectory)RvtInstallPath.props" />
	<Import Project="$(MSBuildThisFileDirectory)RvtVersions.props" />

	<PropertyGroup>
		<Configurations>r2022;r2024;r2025</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RevitVersion)' != ''">
		<DefineConstants>$(DefineConstants);REVIT_$(RevitVersion)</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>


	<ItemGroup Condition="'$(RevitVersion)' != ''">
		<Reference Include="RevitAPI">
			<HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="RevitAPIUI">
			<HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="AdWindows">
			<HintPath>$(RevitApiPath)\AdWindows.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	
	<PropertyGroup Condition="'$(RevitVersion)' != ''">
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<Target Name="CheckRevitVersion" BeforeTargets="BeforeBuild" Condition="'$(RevitVersion)' == ''">
		<Error Text="RevitVersion не задан. Выберите конфигурацию r2019..r2026 (текущая: $(Configuration))." />
	</Target>

	<PropertyGroup Condition="'$(RevitVersion)' != ''">
		<RevitAddinsPath>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsPath>
		<PluginOutputPath>$(RevitAddinsPath)\AutoNumber</PluginOutputPath>
		<AddinManifestPath>$(ProjectDir)..\AddinManifests\AutoNumber.addin</AddinManifestPath>
	</PropertyGroup>
	
	<Target Name="DeployRevitPlugin"
        AfterTargets="Build"
        Condition="'$(RevitVersion)' != ''">

		<Message Importance="High"
				 Text="=== DeployRevitPlugin START ===" />

		<Message Importance="High"
				 Text="Configuration: $(Configuration)" />

		<Message Importance="High"
				 Text="RevitVersion: $(RevitVersion)" />

		<Message Importance="High"
				 Text="TargetDir: $(TargetDir)" />

		<Message Importance="High"
				 Text="PluginOutputPath: $(PluginOutputPath)" />

		<Message Importance="High"
				 Text="RevitAddinsPath: $(RevitAddinsPath)" />

		<MakeDir Directories="$(RevitAddinsPath)" />
		<MakeDir Directories="$(PluginOutputPath)" />

		<ItemGroup>
			<PluginFiles Include="$(TargetDir)**\*.*" />
		</ItemGroup>

		<Copy
			SourceFiles="@(PluginFiles)"
			DestinationFiles="@(PluginFiles->'$(PluginOutputPath)\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />

		<Copy
			SourceFiles="$(AddinManifestPath)"
			DestinationFiles="$(RevitAddinsPath)\AutoNumber.addin"
			SkipUnchangedFiles="true" />

		<Message Importance="High"
				 Text="=== DeployRevitPlugin FINISHED ===" />

	</Target>

</Project>