<!--RevitProject.props-->
<Project>

	<Import Project="$(MSBuildThisFileDirectory)RvtInstallPath.props" />
	<Import Project="$(MSBuildThisFileDirectory)RvtVersions.props" />

	<PropertyGroup>
		<Configurations>r2022;r2024;r2025</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RevitVersion)' != ''">
		<DefineConstants>$(DefineConstants);REVIT_$(RevitVersion)</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>


	<ItemGroup Condition="'$(RevitVersion)' != ''">
		<Reference Include="RevitAPI">
			<HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="RevitAPIUI">
			<HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="AdWindows">
			<HintPath>$(RevitApiPath)\AdWindows.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	
	<PropertyGroup Condition="'$(RevitVersion)' != ''">
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<Target Name="CheckRevitVersion" BeforeTargets="BeforeBuild" Condition="'$(RevitVersion)' == ''">
		<Error Text="RevitVersion не задан. Выберите конфигурацию r2019..r2026 (текущая: $(Configuration))." />
	</Target>
</Project>