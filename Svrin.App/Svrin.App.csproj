<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<Configurations>r2022;r2024;r2025</Configurations>
		<UseWPF Condition="'$(TargetFramework)' != 'net48'">true</UseWPF>
	</PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)..\Build\RevitProject.props" />

	<!-- Debug -->
	<PropertyGroup>
		<StartAction>Program</StartAction>
		<StartProgram>$(RevitApiPath)\Revit.exe</StartProgram>
		<StartWorkingDirectory>$(RevitApiPath)</StartWorkingDirectory>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<FrameworkReference Include="Microsoft.WindowsDesktop.App" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Svrin.Core\Svrin.Core.csproj" />
	  <ProjectReference Include="..\Svrin.Wpf\Svrin.Wpf.csproj" />
	</ItemGroup>

</Project>
